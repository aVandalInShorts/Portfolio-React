		{
			"__component": "blocks.about",
			"id": 16,
			"Title": "About Me",
			"Text": [
				{
					"type": "paragraph",
					"children": [
						{
							"text": "As a Full-Stack Developer with Front-End specialization, I'm passionate about creating web applications that combine performance, aesthetics, and maintainability. My expertise spans from designing intuitive user interfaces to building robust backend systems. What sets me apart is my commitment to code excellence: well-structured project, thoughtful architectures, and solid development patterns that stand the test of time.",
							"type": "text"
						}
					]
				},
				{
					"type": "paragraph",
					"children": [
						{
							"text": "Beyond my technical skills, I've developed a strong ability to lead and mentor development teams. As a team lead, I strive to create an environment where each member can grow and actively contribute to architectural decisions. Mentorship and transmitting best practices are essential aspects of effective leadership for me.",
							"type": "text"
						}
					]
				}
			],
			"Hash": "about",
			"MenuValue": "About",
			"List": [
				{
					"id": 46,
					"Title": "Technical Expertise",
					"Text": "Front-End specialization with a Full-Stack vision for scalable architectures"
				},
				{
					"id": 47,
					"Title": "Quality Code",
					"Text": "Building structured, maintainable applications designed to last"
				},
				{
					"id": 48,
					"Title": "Leadership & Mentorship",
					"Text": "Proven ability to lead and guide teams toward excellence"
				}
			]
		},
